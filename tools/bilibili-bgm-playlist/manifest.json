{
  "manifest_version": 3,
  "name": "B站 BGM 歌单助手",
  "version": "1.0",
  "description": "在 B 站视频页读取 BGM 歌名和 bvid，并维护一个 JSON 风格的自定义歌单。",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*"
  ]
}
